{
  "name": "opencode-scheduler",
  "version": "2.0.0-alpha.1",
  "description": "OpenCode v2 plugin for scheduling recurring jobs: durable run claims, supervised no-overlap execution, and OS scheduler adapters (schtasks, systemd, cron, launchd)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "plugin",
    "scheduler",
    "cron",
    "schtasks",
    "systemd",
    "launchd",
    "automation",
    "jobs"
  ],
  "author": "Benjamin Shafii",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CENFARG/opencode-scheduler.git"
  },
  "bugs": {
    "url": "https://github.com/CENFARG/opencode-scheduler/issues"
  },
  "homepage": "https://github.com/CENFARG/opencode-scheduler#readme",
  "dependencies": {
    "@opencode/plugin": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "typescript": "5.7.3",
    "vitest": "2.1.9"
  }
}
